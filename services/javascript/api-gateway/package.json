{
  "name": "@ecotransit/api-gateway",
  "version": "1.0.0",
  "description": "EcoTransit API Gateway Service",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx --watch src/index.ts",
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ecotransit/contracts": "*",
    "@ecotransit/core-utils": "*",
    "@ecotransit/data-access": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
