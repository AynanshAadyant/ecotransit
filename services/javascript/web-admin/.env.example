# EcoTransit Web Admin & Staff Portal Environment Configuration
# Copy this file to .env or .env.local for local overrides. Never commit .env to source control.

# Base REST API Gateway / Backend URL (must include /api prefix)
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket Telemetry Gateway URL (origin without path)
VITE_WS_URL=http://localhost:5000
