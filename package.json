{
  "name": "ecotransit",
  "version": "1.0.0",
  "private": true,
  "description": "Cost-Effective, Resilient Public Transit Tracking and Predictive Journey-Planning Architecture",
  "workspaces": [
    "shared/javascript/*",
    "services/javascript/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "test:infra": "tsx --test test/**/*.test.ts",
    "test:phase0": "tsx --test test/**/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "migrate": "tsx database/migrate.ts",
    "seed": "tsx database/seed.ts",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules",
    "dev:gateway": "tsx services/javascript/api-gateway/src/index.ts",
    "dev:commuter": "npm run dev --workspace=web-commuter",
    "dev:admin": "npm run dev --workspace=web-admin",
    "dev:staff": "npm run dev --workspace=web-staff",
    "typecheck:frontend": "npm run typecheck --workspaces --if-present",
    "build:frontend": "npm run build --workspace=web-commuter && npm run build --workspace=web-admin && npm run build --workspace=web-staff"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@pinojs/redact": "^0.4.0"
  }
}
