# ============================================================
# ECO-TRANSIT BACKEND CONFIGURATION
# ============================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:5173

# --- JWT Configuration ---
JWT_SECRET=super_secret_eco_transit_jwt_key_college_proj_2026
JWT_EXPIRES_IN=24h

# --- PostgreSQL / PostGIS Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecotransit
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full connection URL (overrides separate parameters if provided):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecotransit

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional full Redis URL:
# REDIS_URL=redis://localhost:6379

# --- MQTT Configuration (ESP32 IoT Ingestion) ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_GPS_TOPIC=ecotransit/vehicles/+/gps
# If true, runs an embedded MQTT broker on port 1883 if external broker is unavailable
EMBEDDED_MQTT_ENABLED=true
EMBEDDED_MQTT_PORT=1883

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# --- GPS Persistence Strategy ---
# Minimum interval in seconds between PostgreSQL GPS log writes per vehicle (to prevent DB flooding)
GPS_DB_WRITE_INTERVAL_SEC=15
# Distance threshold in meters to trigger an immediate DB write regardless of interval
GPS_DB_MIN_DISTANCE_METERS=50
# Inactivity seconds after which a vehicle is marked offline in Redis/WebSocket
VEHICLE_OFFLINE_TIMEOUT_SEC=90

# --- Default Seed Admin ---
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@ecotransit.org"
SEED_ADMIN_PASSWORD="AdminPassword@123"
SEED_ADMIN_PHONE="+919876543210"
