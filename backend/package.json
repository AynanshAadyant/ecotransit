{
  "name": "eco-transit-backend",
  "version": "1.0.0",
  "description": "Eco-Transit Admin & Staff Backend with Real-Time IoT GPS Tracking, Redis caching and WebSockets",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/utils/initDb.js",
    "db:seed": "node src/utils/seedDb.js",
    "simulate:gps": "node src/mqtt/simulator.js",
    "test": "node tests/run-tests.js"
  },
  "keywords": [
    "eco-transit",
    "iot",
    "gps",
    "express",
    "postgres",
    "postgis",
    "redis",
    "mqtt",
    "socketio"
  ],
  "author": "Eco-Transit Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.3",
    "pg": "^8.13.1",
    "pg-mem": "^3.0.14",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "aedes": "^0.51.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
