{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehiclePosition",
  "description": "Language-neutral JSON schema for edge vehicle telemetry & MQTT payloads",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "description": "Unique identifier for physical bus / edge device"
    },
    "route_id": {
      "type": "string",
      "description": "Route ID being operated"
    },
    "trip_id": {
      "type": ["string", "null"],
      "description": "GTFS trip ID if scheduled"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0
    },
    "bearing": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 360.0
    },
    "speed": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "description": "Speed in m/s"
    },
    "timestamp": {
      "type": "integer",
      "description": "GPS epoch seconds timestamp"
    },
    "nearest_stop_sequence": {
      "type": ["integer", "null"]
    },
    "is_speed_suspect": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["vehicle_id", "route_id", "latitude", "longitude", "timestamp"]
}
